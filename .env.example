# Server Configuration
PORT=3000
NODE_ENV=development

# ─── Email Feature Flag ────────────────────────────────────────────────────────
# Set to true to enable email sending (requires valid EMAIL_USER + EMAIL_PASS)
# Set to false to disable all emails — OTP will be printed in server logs instead
EMAIL_ENABLED=false

# Email Configuration (Gmail — requires an App Password, not your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=your-email@gmail.com

# CORS
FRONTEND_URL=http://localhost:4200

# Auth
JWT_SECRET=your-jwt-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password

# ─── Firebase ─────────────────────────────────────────────────────────────────
# Get these from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# ─── AI Chatbot (Optional - Leave empty to disable AI features) ────────────────
# Primary: Google Gemini API (FREE - Get key from Google AI Studio)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-exp

# Fallback: OpenRouter API (FREE models available)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Local Backup: Ollama (Self-hosted, runs on localhost:11434)
# https://ollama.ai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# AI Generation Settings
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TOP_P=0.95
AI_TOP_K=40
