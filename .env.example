# ==============================================================================
# PORTFOLIO BACKEND SERVER ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# ─── Server & Application Configuration ──────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=https://www.mohammadmuzzamil.space/

# ─── Admin Authentication & Security ──────────────────────────────────────────
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password
JWT_SECRET=your-random-32-character-secret-key

# ─── Email Service (Nodemailer / Gmail) ───────────────────────────────────────
# Set EMAIL_ENABLED=true to send actual emails. If false, OTPs log to server console.
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

# ─── Firebase Database & Admin SDK ───────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=12345678901234567890
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com

# ─── AI Chatbot Integrations ──────────────────────────────────────────────────
# Primary Provider: Google Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3-flash-preview

# Fallback Provider: OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Local Provider Backup: Ollama (https://ollama.ai)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# AI Generation Parameters
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TOP_P=0.95
AI_TOP_K=40
